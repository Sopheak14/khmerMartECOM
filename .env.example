# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
SPRING_PROFILES_ACTIVE=dev

# Database
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/khmermart
DB_USER=khmermart
DB_PASSWORD=khmermart

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT Secrets (min 32 characters)
JWT_ACCESS_SECRET=khmermart_jwt_access_secret_key_must_be_at_least_32_chars_long
JWT_REFRESH_SECRET=khmermart_jwt_refresh_secret_key_must_be_at_least_32_chars_long
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# Mail. Defaults below target Mailpit (dev, no auth).
# Real email via Gmail SMTP: put these in your local .env (never commit it):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-account@gmail.com
#   MAIL_PASSWORD=<16-char Google App Password, not your login password>
#   MAIL_FROM=KhmerMart <your-account@gmail.com>
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=KhmerMart <no-reply@khmermart.local>
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@khmermart.local

# File Storage
UPLOAD_DIR=uploads

# Bakong KHQR
KHQR_MODE=MOCK
KHQR_TYPE=INDIVIDUAL
BAKONG_API_BASE=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=
BAKONG_TOKEN_EXPIRES_AT=
BAKONG_ACCOUNT_ID=khmermart@aclb
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
BAKONG_MERCHANT_NAME=KhmerMart
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_MOBILE=85512345678
BAKONG_STORE_LABEL=KhmerMart Online
BAKONG_TERMINAL_LABEL=WEB-01
BAKONG_DEEPLINK_URL=
KHQR_CURRENCY=USD
KHQR_EXPIRE_MINUTES=10
KHQR_POLL_INTERVAL_SECONDS=5
USD_KHR_RATE=4100

# Email OTP: HMAC pepper for stored code hashes. Set a long random value in prod.
# OTP_PEPPER=<long random string>   (leave unset in dev to use the built-in default)
